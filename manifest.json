{
  "manifest_version": 2,
  "name": "Price Tracker — Ozon, WB, Я.Маркет, Ali",
  "version": "3.2",
  "description": "Отслеживание цен на Ozon, Wildberries, Яндекс.Маркет и AliExpress с историей, графиком, сравнением цен и уведомлениями",
  "author": "Негодин А.А.",
  "browser_specific_settings": {
    "gecko": {
      "id": "retroys.w@yandex.ru",
      "strict_min_version": "109.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "https://www.ozon.ru/*",
    "https://ozon.ru/*",
    "https://www.ozon.kz/*",
    "https://ozon.kz/*",
    "https://www.wildberries.ru/*",
    "https://wildberries.ru/*",
    "https://market.yandex.ru/*",
    "https://market.yandex.by/*",
    "https://market.yandex.kz/*",
    "https://www.aliexpress.com/*",
    "https://aliexpress.com/*",
    "https://www.aliexpress.ru/*",
    "https://aliexpress.ru/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.ozon.ru/product/*",
        "https://ozon.ru/product/*",
        "https://www.ozon.kz/product/*",
        "https://ozon.kz/product/*"
      ],
      "js": ["storage.js", "core.js", "ozon.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://www.wildberries.ru/catalog/*",
        "https://wildberries.ru/catalog/*"
      ],
      "js": ["storage.js", "core.js", "wildberries.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://market.yandex.ru/card/*",
        "https://market.yandex.ru/product/*",
        "https://market.yandex.by/card/*",
        "https://market.yandex.by/product/*",
        "https://market.yandex.kz/card/*",
        "https://market.yandex.kz/product/*"
      ],
      "js": ["storage.js", "core.js", "yandex.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://www.aliexpress.com/item/*",
        "https://aliexpress.com/item/*",
        "https://www.aliexpress.ru/item/*",
        "https://aliexpress.ru/item/*"
      ],
      "js": ["storage.js", "core.js", "aliexpress.js"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "scripts": ["storage.js", "background.js"],
    "persistent": false
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Price Tracker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}